{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.venv",
      "!receipts",
      // `keeperhub-safe` is written in KeeperHub's conventions, against their tsconfig
      // paths and their formatter. Formatting it to ours would produce a diff a reviewer
      // has to undo, so it is checked by their tooling inside a clone of their repo
      // instead.
      "!packages/keeperhub-safe"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Structured logging only (CLAUDE.md §5). No console.log of objects.
        "noConsole": { "level": "error", "options": { "allow": ["error"] } }
      },
      "style": {
        // Strict mode, no non-null assertions (CLAUDE.md §5).
        "noNonNullAssertion": "error"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
