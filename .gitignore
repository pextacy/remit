# Fork deployments are regenerated on every run; a real one is evidence and is committed.
# `anvil-base` names a Safe on a fork of Base mainnet, which a reader could mistake for
# the real thing — exactly the confusion a mainnet proof must never invite.
ops/deployments/anvil.json
ops/deployments/anvil-base.json
ops/deployments/*.ledger.json
ops/remits/anvil.json
receipts/anvil/
receipts/anvil-base/
ops/remits/anvil-base.json
ops/review/
.next/
next-env.d.ts

# Next.js writes its own agent-guidance files into the console package on first run. A
# second CLAUDE.md with different rules is a trap for whoever reads the repo next: the
# working agreement is the one at the root.
packages/remit-console/CLAUDE.md
packages/remit-console/AGENTS.md
