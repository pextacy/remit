# Copy to .env and fill in. .env is gitignored and must never be committed:
# no key, credential or token enters the repository, a log line, or an error
# message (CLAUDE.md §2.4).

# --- Chain -----------------------------------------------------------------
# Base Sepolia is the default for every script. Mainnet needs --network base.
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# The EOA that is a member of the Roles roleKey. Never an owner of the Safe.
# Held by KeeperHub in the real path; a local key only for the P1 hand-run.
AGENT_SIGNER_PRIVATE_KEY=

# --- KeeperHub -------------------------------------------------------------
# Created at https://app.keeperhub.com. Scope: mcp:read is required by
# GET /api/execute/{executionId}/status.
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# --- Almanak ---------------------------------------------------------------
# A strategy container reaches its gateway through these. Pointing them at the
# Remit bridge is how Remit becomes the execution seam without forking the SDK.
ALMANAK_GATEWAY_HOST=localhost
ALMANAK_GATEWAY_PORT=50051
ALMANAK_GATEWAY_AUTH_TOKEN=

# --- Deployment (filled in by P1 and P6, committed to docs/VERIFIED.md) -----
SAFE_ADDRESS=
ROLES_MODIFIER_ADDRESS=
ROLE_KEY=
