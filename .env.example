# Copy to .env and fill in what the path you are running actually needs. .env is
# gitignored and must never be committed: no key, credential or token enters the
# repository, a log line, or an error message (CLAUDE.md §2.4).
#
# --- HOW THESE REACH A PROCESS ---------------------------------------------
#
# Nothing in this repository reads .env. There is no dotenv dependency on either side,
# and adding one would be a second implementation of a standard thing — so these are
# ordinary environment variables and the file is a place to keep them, not a thing that
# loads itself. Source it into the shell you run commands from:
#
#     set -a; . ./.env; set +a
#
# Say that out loud rather than leave it implied, because the failure is silent. A
# REMIT_CONSOLE_TOKEN sitting unread in a file is an operator who believes the review
# queue asks for a secret, and a queue that does not — which is the one variable here
# whose absence is a security property rather than an inconvenience.
#
# `tsx` does not forward node's `--env-file`, and node refuses it inside NODE_OPTIONS,
# so there is no per-command shortcut for the ops scripts. The bridge has one of its own:
# `uv run --env-file .env --directory packages/remit-bridge remit …`. The console is the
# exception — Next reads a .env in `packages/remit-console/`, not this one.
#
# Everything unset falls back to something safe or refuses: mainnet has no default RPC,
# the bridge without a KeeperHub key runs dry only, and the console without a token
# answers G3 only for this machine.
#
# --- WHAT A FORK NEEDS ------------------------------------------------------
#
# Nothing here is required to run against a local fork. `anvil` holds the keys, this
# process holds none, and that is the point — a repository that never holds a key
# cannot leak one. The sections below say which path needs which variable.

# --- Which chain ------------------------------------------------------------
# Base Sepolia is the default for every script; mainnet additionally needs --confirm.
# `anvil` is a fork of Base Sepolia, `anvil-base` a fork of Base mainnet.
#
# Needed: base-sepolia and base only. The fork defaults to 127.0.0.1.
#
# Where from: any Base RPC provider — Alchemy, Infura, QuickNode, Ankr — or the public
# endpoints https://sepolia.base.org and https://mainnet.base.org. Sepolia falls back to
# the public one; mainnet has no default, because a wrong endpoint on mainnet is a wrong
# chain for real money. The public endpoints rate-limit, which `verify:constants` reports
# as unread rather than as a constant that changed.
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# Where the forks listen, if not on their default ports.
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_BASE_RPC_URL=http://127.0.0.1:8547

# --- Keys — off a fork only -------------------------------------------------
# The EOA that is a member of the Roles roleKey. Never an owner of the Safe: an agent
# key that is also an owner key makes every gate downstream decorative.
#
# Held by KeeperHub on the real path. A local key is only for the P1 hand-run.
#
# Where from: generate one. `cast wallet new` prints an address and a private key. It
# needs ETH for gas only on the ops-direct path; KeeperHub pays on its own. Generate it
# fresh — an agent key is an address that should own nothing, and `castFor` refuses to
# start if it is also one of the Safe owners below.
AGENT_SIGNER_PRIVATE_KEY=

# The two Safe owners this machine can sign for. The third is an address we hold no key
# for — a hardware wallet, or a teammate — because 2-of-3 with two hot keys makes the
# third owner decoration.
#
# Where from: `cast wallet new` twice for the two hot ones — owner 1 pays for the
# deployments, so it needs ETH. The third is an address you already have a key for
# somewhere this machine cannot reach: a hardware wallet's receive address, or a
# teammate's. Address only, never the key.
SAFE_OWNER_1_PRIVATE_KEY=
SAFE_OWNER_2_PRIVATE_KEY=
SAFE_OWNER_3_ADDRESS=

# Somewhere funds must never be able to go. The out-of-preset probe sends a refused
# transaction at it, so pick an address you control and can check the balance of.
# `cast wallet new` again, or any address of yours. It never needs funding or a key here.
ATTACKER_ADDRESS=

# --- USDC, which is not a variable ------------------------------------------
# Not read from the environment — the Safe holds it on chain. On a fork, `pnpm --filter
# ops fund` mints or transfers it from a real holder. On Base Sepolia, Aave's own faucet
# at https://app.aave.com/faucet (switch to Base Sepolia) issues the *Aave-listed* USDC,
# which is the token this build uses — not Circle's testnet USDC, and picking the other
# one gives a revert that looks like a preset failure and is not. On mainnet, send real
# USDC to the Safe. 30 USDC covers the whole run at the caps in CLAUDE.md §2.4.

# --- KeeperHub — the only thing that submits a transaction ------------------
# Created at https://app.keeperhub.com. Scope: mcp:read is required by
# GET /api/execute/{executionId}/status.
#
# Without a key, `remit serve` still answers CompileIntent and a dry-run Execute — G1 and
# G2 both run — and refuses a real Execute rather than finding another way to send.
KEEPERHUB_API_KEY=
# Every request built from this carries the key in an `Authorization` header, so it has
# to be https — the client refuses plain http to anywhere but 127.0.0.1, where a local
# stub is how the client is exercised without an account.
KEEPERHUB_BASE_URL=https://app.keeperhub.com
# A workflow registered in advance, invoked by id with typed inputs (KH-2). Unset, the
# bridge uses the direct-execution route and the receipt records which one ran.
#
# Where from: register `ops/workflows/exec-with-role.workflow.json` in the KeeperHub
# console; the id it assigns goes here. That document is Remit's declaration of what must
# run and is hashed into the Remit as `workflowHash` — if KeeperHub's own definition of
# the registered workflow differs, reissue the Remit against it rather than editing the
# hash (docs/OPEN_QUESTIONS.md OQ-7).
KEEPERHUB_WORKFLOW_ID=

# --- Almanak ----------------------------------------------------------------
# A strategy container reaches its gateway through these. Pointing them at the Remit
# bridge is how Remit becomes the execution seam without forking the SDK. The precedence
# ladder is Almanak's own (`GatewayClientConfig.from_env`), so nothing about the strategy
# changes.
ALMANAK_GATEWAY_HOST=127.0.0.1
ALMANAK_GATEWAY_PORT=50051
# Read by the SDK, not by us (`gateway_client.py`: ALMANAK_GATEWAY_AUTH_TOKEN >
# GATEWAY_AUTH_TOKEN). Unset for a local gateway, which is what `remit serve` is.
ALMANAK_GATEWAY_AUTH_TOKEN=
ALMANAK_GATEWAY_TIMEOUT=30

# `remit serve` binds an *unauthenticated* gRPC port — that is the shape Almanak's own
# gateway has, and its client expects. On loopback that is the same trust boundary as the
# filesystem the receipts live on. On any other interface it is an open endpoint that
# submits transactions under the Safe's role, so binding there has to be said out loud:
# set this to 1 only when you have put authentication in front of it yourself.
REMIT_ALLOW_REMOTE_GATEWAY=

# --- Console ----------------------------------------------------------------
# Which network's files the console reads. One operator, one chain at a time. It reads
# the repository directly — there is no database and no API — so this is the only thing
# it needs, and it needs no key at all.
REMIT_NETWORK=base-sepolia

# Who may answer G3.
#
# The console binds to 127.0.0.1 (`packages/remit-console/package.json`), so by default
# the review queue is not on the network and needs no secret. The moment it is exposed —
# a tunnel, a container, a colleague's browser — that stops being true: a server action
# is a public endpoint, and anything that can reach the port can approve an action under
# the Remit. Set this, and every decision has to carry it.
#
# Any long random string. `openssl rand -hex 32` is fine. Unset, the console takes a
# decision only when the request arrived over loopback — judged from the socket's own
# address, not from the `Host` the sender typed — and refuses with a reason otherwise.
# A proxy in front of it makes that judgement unavailable, which is exactly when to set
# this.
REMIT_CONSOLE_TOKEN=

# The review queue itself is `ops/review/` — a directory of JSON files, written by the ops
# pipeline and by `remit serve`, read by the console. No database and no API between them,
# so G3 works with the console restarted, replaced by a text editor, or absent (in which
# case an action above the threshold is refused rather than waved through).

# --- Rarely touched ---------------------------------------------------------
# How long the Python bridge waits for one call into the TypeScript core, in seconds.
REMIT_CORE_TIMEOUT=60

# --- Written by the tooling, not by you -------------------------------------
# `safe:deploy`, `roles:deploy` and `roles:apply` record the deployment in
# ops/deployments/<network>.json, and `remit:issue` records the Remit in
# ops/remits/<network>.json. Both are read from there by every later command, and neither
# holds key material.
